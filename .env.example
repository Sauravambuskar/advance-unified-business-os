# Frejun API Integration
# Copy this file to .env and fill in your values.

# Your FreJun API key — Settings → Developer → API Key
VITE_FREJUN_API_KEY=your_api_key_here

# The FreJun account email of the agent placing calls.
# Must match a user in your FreJun account.
# You can also set this dynamically from the Dialer Settings (⚙ gear icon in header).
VITE_FREJUN_USER_EMAIL=agent@yourcompany.com
